# API base URL (origin only, no trailing slash)
ANERA_MARKETS_API_BASE_URL=https://api.anera.markets

# Intelligence endpoints: dual-key authentication
# ANERA_MARKETS_API_ACCESS_KEY=your_access_key
# ANERA_MARKETS_API_SECRET_KEY=your_secret_key

# Extended history (ticker data beyond 7 days)
# ANERA_MARKETS_API_KEY=iai_sk_your_access_key
